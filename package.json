{
  "name": "jamiblossom",
  "version": "0.1.0",
  "description": "WASM-first Zi Wei Dou Shu and East Asian calendar charting library.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calculate": {
      "types": "./dist/calculate.d.ts",
      "import": "./dist/calculate.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    }
  },
  "files": [
    "dist",
    "wasm/Cargo.toml",
    "wasm/Cargo.lock",
    "wasm/src",
    "wasm/LICENSE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "wasm-pack build wasm --target web --out-dir ../src/wasm-pkg --out-name jamiblossom_core",
    "typecheck": "tsc --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "pretest": "pnpm build",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --force",
    "prebuild:web": "pnpm build",
    "build:web": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck:web": "tsc -p tsconfig.app.json --noEmit",
    "seo:analyze": "node scripts/seo-batch.mjs"
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
